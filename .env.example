# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API). Never commit the real .env file.

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional — powers the "Turn this into a project brief" AI feature.
# Leave unset to disable that feature safely.
LOVABLE_API_KEY=""
